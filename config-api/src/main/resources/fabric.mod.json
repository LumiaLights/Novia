{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "A Novia module for building elaborate configuration systems.",
    "authors": [ "LumiaLights" ],
    "icon": "assets/${mod_id}/icon.png",
    "contact": {
        "homepage": "https://lumialights.xyz/",
        "sources": "https://github.com/LumiaLights/Novia",
        "issues": "https://github.com/LumiaLights/Novia/issues"
    },
    "license": "MIT",
    "environment": "*",
    "entrypoints": {
        "client": ["xyz.lumialights.novia.api.config.client.ConfigApiClient"],
        "main": ["xyz.lumialights.novia.api.config.ConfigApi"],
        "modmenu": ["xyz.lumialights.novia.api.config.client.gui.ConfigMenuProvider"],
        "fabric-datagen": ["xyz.lumialights.novia.api.config.data.ConfigApiDataProvider"]
    },
    "mixins": [
        {
            "config": "${mod_id}.server.mixins.json",
            "environment": "server"
        },
        {
            "config": "${mod_id}.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "java": "${java_version}",
        "minecraft": ">=${minecraft_version}",
        "novia-core-api": "*"
    }
}
