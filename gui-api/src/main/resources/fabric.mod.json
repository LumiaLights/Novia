{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "A useful fabric module for the Novia that provides some GUI and general 2D drawing utils.",
    "authors": ["LumiaLights"],
    "contact": {
        "homepage": "https://lumialights.xyz/",
        "sources": "https://github.com/LumiaLights/Novia",
        "issues": "https://github.com/LumiaLights/Novia/issues"
    },
    "accessWidener": "novia-gui-api.accesswidener",
    "license": "MIT",
    "icon": "assets/${mod_id}/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [ "xyz.lumialights.novia.api.gui.GuiApi" ],
        "fabric-datagen": ["xyz.lumialights.novia.api.gui.data.GuiApiDataProvider"]
    },
    "mixins": [
        {
            "environment": "client",
            "config": "${mod_id}.client.mixins.json"
        }
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "java": "${java_version}",
        "minecraft": ">=${minecraft_version}",
        "novia-core-api": "*"
    }
}
